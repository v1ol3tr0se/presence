{
	"name": "presence",
	"version": "2.0.0",
	"description": "Keeps your Discord account showing online even when Discord is closed, custom status included.",
	"homepage": "https://github.com/v1ol3tr0se/presence",
	"bugs": {
		"url": "https://github.com/v1ol3tr0se/presence/issues"
	},
	"license": "AGPL-3.0-only",
	"author": {
		"name": "v1ol3tr0se",
		"url": "https://github.com/v1ol3tr0se"
	},
	"type": "module",
	"main": "dist/index.js",
	"private": true,
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "yarn clean && tsc --pretty false",
		"typecheck": "tsc --noEmit --pretty false",
		"lint": "biome check .",
		"format": "biome check --write .",
		"watch": "tsc -w",
		"start": "node dist/index.js",
		"test": "yarn build && node test/test.ts && node test/test-status.ts",
		"verify": "yarn typecheck && yarn lint && yarn test",
		"deploy": "./deploy/deploy.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/node": "^24.3.0",
		"@types/ws": "^8.18.1",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"ws": "^8.18.1"
	},
	"packageManager": "yarn@1.22.22"
}
